# Copy to .env and fill in. Never commit .env.

# Embeddings (used for the index and for every question)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

# Answer providers in order; the next one is used when one fails or hits its quota.
GENERATORS=openai,gemini

# Any OpenAI-compatible API. Example: Groq.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Only for reasoning models that accept it, e.g. low / medium / high for openai/gpt-oss-120b on Groq.
OPENAI_REASONING_EFFORT=

# Limits
REQUESTS_PER_MINUTE=6
DAILY_LIMIT_PER_VISITOR=20
DAILY_LIMIT=300
MAX_QUESTION_CHARS=500

# Set when the API is called from another origin (for example GitHub Pages).
ALLOWED_ORIGINS=
# Set to 1 behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
